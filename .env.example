# Database. Local: `pnpm db:up` gives you these. Neon: pooled URL below, direct
# URL in DIRECT_URL (migrations need the direct connection).
DATABASE_URL=postgresql://reachin:reachin@localhost:54329/reachin
DIRECT_URL=postgresql://reachin:reachin@localhost:54329/reachin

# LINE. All four are required when LINE_ENABLED=true.
# LINE_LOGIN_CHANNEL_ID and NEXT_PUBLIC_LIFF_ID alone give real sign-in and
# real shared cards, with no Messaging API and no Official Account.
# false makes the whole site an open demo, with no password and no LINE account.
LINE_ENABLED=false
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=

APP_BASE_URL=http://localhost:3000

# Long random strings: openssl rand -hex 32
CRON_SECRET=
# Only used when LINE_ENABLED=true.
DEMO_SECRET=

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts device HMAC secrets at rest. Rotating it invalidates every device.
DEVICE_SECRET_KEY=

ARRIVAL_RADIUS_M=100
ARRIVAL_TIMEOUT_MIN=10
NO_ACCEPT_ESCALATE_MIN=3
HEARTBEAT_TIMEOUT_MIN=15
